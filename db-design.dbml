Table trip {
  id uuid [pk]
  owner_id uuid [ref: > profile.id]

}

Table trip_invite {
  id uuid [pk]
  trip_id uuid [ref: > trip.id]
  invite_id uuid [unique]
  created_at timestamptz
  ending_at timestamptz
}


Table profile {
  id uuid [pk]
  user_id uuid [unique, ref: - user.id]
  name text
  color int
  emoji text
}

Table guest_trip {
  profile_id uuid [ref: > profile.id]
  trip_id uuid [ref: > trip.id]
}

Table shopping_list_history {
  id uuid [pk, default: `gen_random_uuid()`]
  trip_id uuid [ref: > trip.id]
  valid_from timestamptz
  shopping_list_item_id uuid [ref: > shopping_list_item.id]
  bought_at timestamptz
  removed_at timestamptz
  unit Unit
  amount numeric

  indexes {
    (trip_id, valid_from, shopping_list_item_id) [name: "shopping_list_history_trip_id_valid_from_shopping_list_item_id_idx"]
  }
}

Table shopping_list_item {
  id uuid [pk]
  category Category
  name text
}

Enum Category {
  FOOD
  DRINK
  DAIRY
  OTHER
}

Enum Unit {
  KILOGRAM
  GRAM
  LITER
  MILLILITER
  AMOUNT
}

Table user {
  id uuid [pk, not null]
  image_url text
}

Table bill {
  id uuid [pk]
  image_url text
  bills uuid [ref: > bills.id]
}

Table bills {
  id uuid [pk]

}
