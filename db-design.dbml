Table trip {
  id uuid [pk]
  invite_id text [unique]
  owner_id uuid [ref: > profile.id]

}

Table profile {
  id uuid [pk]
  user_id uuid [unique, ref: - user.id]
  name text
  color int
  emoji text
}

Table guest_trip {
  profile_id uuid [ref: > profile.id]
  trip_id uuid [ref: > trip.id]
}

Table shopping_list_history {
  trip_id uuid [pk, ref: > trip.id]
  valid_from timestamptz [pk]
  shopping_list_item_id uuid [pk, ref: > shopping_list_item.id]
  bought_at timestamptz
  removed_at timestamptz
  unit Unit
  amount numeric
}

Table shopping_list_item {
  id uuid [pk]
  category Category
  name text
}

Enum Category {
  FOOD
  DRINK
  DAIRY
  OTHER
}

Enum Unit {
  KILOGRAM
  GRAM
  LITER
  MILLILITER
  AMOUNT
}

Table user {
  id uuid [pk, not null]
  image_url text
}

Table bill {
  id uuid [pk]
  image_url text
  bills uuid [ref: > bills.id]
}

Table bills {
  id uuid [pk]

}
